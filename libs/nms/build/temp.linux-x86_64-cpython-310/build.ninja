ninja_required_version = 1.3
cxx = c++

cflags = -pthread -B /network_space/server127_2/shared/zhengmh/conda_envs/mvtg/compiler_compat -Wno-unused-result -Wsign-compare -DNDEBUG -fwrapv -O2 -Wall -fPIC -O2 -isystem /network_space/server127_2/shared/zhengmh/conda_envs/mvtg/include -fPIC -O2 -isystem /network_space/server127_2/shared/zhengmh/conda_envs/mvtg/include -fPIC -I/network_space/server127_2/shared/zhengmh/conda_envs/mvtg/lib/python3.10/site-packages/torch/include -I/network_space/server127_2/shared/zhengmh/conda_envs/mvtg/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/network_space/server127_2/shared/zhengmh/conda_envs/mvtg/lib/python3.10/site-packages/torch/include/TH -I/network_space/server127_2/shared/zhengmh/conda_envs/mvtg/lib/python3.10/site-packages/torch/include/THC -I/network_space/server127_2/shared/zhengmh/conda_envs/mvtg/include/python3.10 -c
post_cflags = -fopenmp -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=nms_1d_cpu_vg -D_GLIBCXX_USE_CXX11_ABI=0 -std=c++17
cuda_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc





build /network_space/server128/shared/weijingli/Multimodal-Video-Temporal-Grounding-main/libs/nms/build/temp.linux-x86_64-cpython-310/./src/nms_cpu.o: compile /network_space/server128/shared/weijingli/Multimodal-Video-Temporal-Grounding-main/libs/nms/src/nms_cpu.cpp






